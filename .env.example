# Choose ONE Firebase authentication method. Never put actual keys in this file.
# Relative paths are resolved from the project root.
# Priority: JSON > FIREBASE_SERVICE_ACCOUNT_PATH > GOOGLE_APPLICATION_CREDENTIALS.
# Without these variables, the existing root firebase-service-account.json is used.
# Copy this file to .env for local settings; .env is excluded from Git.
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={...service account JSON...}
FIRESTORE_DATABASE_ID=(default)

# Optional until AI chat is used.
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=

# Output is clamped to 64..3000 tokens; invalid values use 1200.
OPENAI_MAX_COMPLETION_TOKENS=1200
# For a compatible endpoint requiring the legacy parameter, use max_tokens.
# No automatic retry/fallback is performed if the endpoint rejects a parameter.
OPENAI_TOKEN_LIMIT_PARAMETER=max_completion_tokens
# Client timeout: 30 seconds. SDK automatic retries: 0.
# Question: 2000 characters. Saved messages: 100 / 40000 characters total.
# Reply: 8000 characters max, reserved before the request.
# Full AI input (system context + conversation): 80000 characters max.

# REQUIRED authentication settings. No default account/password is provided.
# Run tools/setup_local_auth.py manually to create an ignored local .env.auth.
# Production uses HTTPS, HttpOnly __Host-m1_session; local HTTP requires development.
APP_ENV=production
EVAL_USERNAME=
EVAL_PASSWORD_HASH=
AUTH_SECRET=
AUTH_VERSION=1
AUTH_ALLOWED_ORIGINS=
SESSION_ABSOLUTE_SECONDS=28800
SESSION_IDLE_SECONDS=3600
LOGIN_IP_LIMIT=10
LOGIN_GLOBAL_LIMIT=60
AI_SESSION_MINUTE_LIMIT=3
AI_GLOBAL_MINUTE_LIMIT=5
AI_GLOBAL_DAY_LIMIT=100

# Vercel only: public fixed Render origin. Never provide backend secrets to Vercel.
# BACKEND_ORIGIN=https://your-approved-backend.onrender.com
